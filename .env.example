DATABASE_URL=postgresql://reconcile_app:reconcile_dev@localhost:5432/reconcile
POSTGRES_USER=reconcile_app
POSTGRES_PASSWORD=reconcile_dev
POSTGRES_DB=reconcile
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set in deployed environments to the real, publicly reachable frontend
# origin (e.g. https://your-app.vercel.app) so the backend's CORS policy
# accepts requests from it. Unset locally -- defaults to localhost.
FRONTEND_URL=
